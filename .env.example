# Copie este arquivo para ".env" e preencha. Nunca compartilhe o .env.

# OpenRouter - geracao de imagem por IA (opcional; so a modalidade "ai" usa)
OPENROUTER_API_KEY=

# Cloudflare R2 - hospedagem publica das imagens de carrossel
# Passo a passo em docs/pipeline-publicacao.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=instaflow
R2_PUBLIC_BASE=

# Apify - coleta dos posts dos concorrentes (so se coleta_modo for apify)
APIFY_TOKEN=
